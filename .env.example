# Copy to .env (git-ignored) and fill in ONE provider key.
# litellm reads these straight from the environment; config.py loads .env at import.

# Recommended: Groq (free tier, fastest, first in the fallback chain)
GROQ_API_KEY=

# Alternatives (any one is enough; the chain tries them in order)
OPENROUTER_API_KEY=
TOGETHER_API_KEY=
GEMINI_API_KEY=

# Demo tuning (optional)
# CONFORMAL_RAG_NLI_MODEL=small      # "small" = ~0.15s/predict CPU, "large" = ~5s
# CONFORMAL_RAG_USE_LLM_JUDGE=1
# CONFORMAL_RAG_ALPHA=0.15
# CONFORMAL_RAG_STATE_DIR=.state

# Override the model fallback chain (comma separated litellm ids, tried in
# order). Provider model ids are retired without notice, so this is the
# escape hatch when the defaults stop resolving.
# CONFORMAL_RAG_LLM_MODELS=groq/qwen/qwen3.8-27b,groq/openai/gpt-oss-120b